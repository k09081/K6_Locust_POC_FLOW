{
"smoke":{

   "description": "Smoke test to verify basic functionality",
   "stages":[

    {"duration":"5s","target":1}
   ],
   "thresholds":{

     "http_req_duration": ["p(95)<300"],
        "checks": ["rate>0.9"],
        "iteration_duration": ["p(95)<2"]
   }


   },
   "load":{
    "description":"to test the application behaviour on normal anticipated load",
    "stages":[

        {"duration":"2m","target":2},
        {"duration":"4m","target":4},
        {"duration":"6m","target":6},
        {"duration":"8m","target":8},
        {"duration":"10m","target":10},
        {"duration":"12m","target":0}

    ],
    "thresholds":{
        "http_req_duration":["p(95)<400"],
        "checks":["rate>0.9"],
        "iteration_duration":["p(95)<5"]
    }

   },

   "Stess_Testing":{
     "description":"stessing the application beyond capacity",

     "stages":[

        {"duration":"2m","target":10},
        {"duration":"5m","target":20},
        {"duration":"2m","target":50},
        {"duration":"5m","target":10},
        {"duration":"2m","target":20},
        {"duration":"5m","target":100},
        {"duration":"10m","target":0}


     ],
     "thresholds":{
        "http_req_duration":["p(95)<800"],
        "checks":["rate>0.6"],
        "iteration_duration":["p(95)<10"]
    }


   }



}





